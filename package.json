{
  "name": "bga.wayfarers",
  "version": "1.0.0",
  "description": "",
  "main": "modules/js/Game.js",
  "scripts": {
    "build:ts": "rollup -c",
    "build:scss": "sass --no-source-map src/css/Game.scss wayfarers.css",
    "watch:ts": "rollup -c -w",
    "watch:scss": "sass --watch src/css/Game.scss wayfarers.css",
    "watch": "run-p watch:ts watch:scss",
    "build": "run-s build:ts build:scss genmat",
    "predeploy": "run-s build typecheck lint:php tests jstests play",
    "genmat": "php8.4 misc/other/genmat.php misc/*.csv",
    "lint:php": "find modules/php/ -name '*.php' -exec php -l {} + && echo 'All PHP files OK'",
    "lint:ts": "eslint",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint:phpstan": "phpstan analyse -c misc/phpstan.neon",
    "tests:cov": "XDEBUG_MODE=coverage APP_GAMEMODULE_PATH=~/git/bga-sharedcode/misc/ phpunit --bootstrap ./phptests/_autoload.php --coverage-text",
    "tests": "APP_GAMEMODULE_PATH=~/git/bga-sharedcode/misc/ phpunit --display-deprecations --display-warnings --bootstrap ./phptests/_autoload.php  --colors=always phptests",
    "jstests": "TS_NODE_PROJECT=src/tests/tsconfig.json node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON -r ts-node/register node_modules/.bin/mocha -r src/tests/setup.ts src/tests/**/*.spec.ts",
    "play:only": "APP_GAMEMODULE_PATH=~/git/bga-sharedcode/misc/ php8.4 phptests/Harness/play.php",
    "play:render": "TS_NODE_PROJECT=phptests/Harness/tsconfig.json node -r ts-node/register phptests/Harness/render.ts",
    "play": "run-s play:only play:render"
  },
  "author": "Alena Laskavaia",
  "license": "EPL2.0",
  "devDependencies": {
    "@prettier/plugin-php": "^0.22",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/chai": "^4.x.x",
    "@types/jsdom": "^28.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^10.9.2",
    "@types/sinon": "^10.x.x",
    "chai": "^4.x.x",
    "jsdom": "^29.0.1",
    "mocha": "^10.x.x",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6",
    "rollup": "^4.60.0",
    "sass": "^1.32.6",
    "sinon": "^15.x.x",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "plugins": [
      "@prettier/plugin-php"
    ],
    "braceStyle": "1tbs",
    "printWidth": 140,
    "trailingComma": "none"
  }
}
